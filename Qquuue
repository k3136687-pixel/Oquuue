-- =============================================
-- NETWORK HOOK (Wallbang execution)
-- =============================================
pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if wallbangEnabled and (method == "FireServer" or method == "InvokeServer") then
            local name = string.lower(self.Name)
            if string.find(name, "shoot") or string.find(name, "hit") then
                local murderer = GetMurderer()
                if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") then
                    for i, arg in ipairs(args) do
                        if typeof(arg) == "Vector3" then
                            args[i] = murderer.Character.Head.Position
                        end
                    end
                end
            end
        end
        
        return old(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

