local generalAimbot = false
CreateToggle(PageGeneral, "Автонаводка (Общая)", function(val) generalAimbot = val end)

RunService.RenderStepped:Connect(function()
    if generalAimbot then
        local closestTarget = nil
        local shortestDist = math.huge
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local dist = (p.Character.Head.Position - Camera.CFrame.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = p.Character.Head
                end
            end
        end
        if closestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    end
end)

