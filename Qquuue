-- =============================================
CreateToggle(PageKiller, "Убить всех (Авто-телепорт)", function(val)
    if val then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
                    if knife then
                        knife.Parent = char
                        char.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame
                        task.wait(0.04)
                        knife:Activate()
                    end
                end
            end
        end
    end
end)

local silentKill = false
CreateToggle(PageKiller, "Тихий килл (Аура ножа)", function(val) silentKill = val end)

RunService.RenderStepped:Connect(function()
    if silentKill then
        local char = LocalPlayer.Character
        if char and (char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")) then
            local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
            knife.Parent = char
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    if (char.HumanoidRootPart.Position - hrp.Position).Magnitude < 15 then
                        knife:Activate()
                    end
                end
            end
        end
    end
end)

