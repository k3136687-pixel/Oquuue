local tabs = {}
local currentTab = nil

local function CreateTab(tabName)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 82, 1, 0)
    tabBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
    tabBtn.TextSize = 15
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.Parent = TabContainer

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 8)
    tabCorner.Parent = tabBtn

    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Name = tabName .. "Scroll"
    scrollFrame.Size = UDim2.new(1, -20, 1, -140)
    scrollFrame.Position = UDim2.new(0, 10, 0, 100)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 6
    scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(0, 0, 0)
    scrollFrame.Visible = false
    scrollFrame.Parent = ContentFolder

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 8)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = scrollFrame

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
    end)

    tabBtn.MouseButton1Click:Connect(function()
        for name, data in pairs(tabs) do
            data.scroll.Visible = false
            data.button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        end
        scrollFrame.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
    end)

    tabs[tabName] = {button = tabBtn, scroll = scrollFrame}
    
    if not currentTab then
        currentTab = tabName
        scrollFrame.Visible = true
        tabBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 100)
    end

    return scrollFrame
end

