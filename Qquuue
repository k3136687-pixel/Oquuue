local wallbang = false
CreateToggle(PageSheriff, "Прострел стен (Стрельба)", function(val) wallbang = val end)

pcall(function()
    local mt = getrawmetatable(game)
    local old = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if wallbang and (method == "FireServer" or method == "InvokeServer") then
            if string.find(string.lower(self.Name), "shoot") then
                local m = GetMurderer()
                if m and m.Character and m.Character:FindFirstChild("Head") then
                    for i, arg in ipairs(args) do
                        if typeof(arg) == "Vector3" then
                            args[i] = m.Character.Head.Position
                        end
                    end
                end
            end
        end
        return old(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

