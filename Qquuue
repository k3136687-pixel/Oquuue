    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Container

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    table.insert(UI_Registry.Buttons, btn)

    local statusBox = Instance.new("TextLabel")
    statusBox.Size = UDim2.new(0, 42, 0, 20)
    statusBox.Position = UDim2.new(1, -47, 0.5, -10)
    statusBox.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
    statusBox.Text = "OFF"
    statusBox.TextColor3 = Color3.fromRGB(140, 140, 150)
    statusBox.TextSize = 10
    statusBox.Font = Enum.Font.GothamBold
    statusBox.Parent = btn

    Instance.new("UICorner", statusBox).CornerRadius = UDim.new(0, 6)

    local toggleData = { Active = false, StatusBox = statusBox }
    table.insert(UI_Registry.Toggles, toggleData)

    btn.MouseButton1Click:Connect(function()
        toggleData.Active = not toggleData.Active
        if toggleData.Active then
            statusBox.Text = "ON"
            statusBox.TextColor3 = Color3.fromRGB(255, 255, 255)
            statusBox.BackgroundColor3 = currentAccent
        else
            statusBox.Text = "OFF"
            statusBox.TextColor3 = Color3.fromRGB(140, 140, 150)
            statusBox.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
        end
        callback(toggleData.Active)
    end)
    return btn
end

-- Role Detectors
local function GetMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if p.Backpack:FindFirstChild("Knife") or p.Character:FindFirstChild("Knife") then
                return p
            end
        end
    end
    return nil
end

