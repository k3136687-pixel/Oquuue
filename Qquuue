                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end)

-- =============================================
-- ЛОГИКА АНИМАЦИИ ЗАГРУЗКИ И ЗАПУСКА
-- =============================================

task.spawn(function()
    -- Анимация заполнения шкалы
    local tweenInfo = TweenInfo.new(1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(ProgressBarFill, tweenInfo, {Size = UDim2.new(1, 0, 1, 0)})
    tween:Play()
    
    task.wait(0.6)
    LoadStatus.Text = "Проверка компонентов..."
    task.wait(0.6)
    LoadStatus.Text = "Готово!"
    task.wait(0.6)

    -- Исчезновение загрузки
    local fadeOut = TweenService:Create(LoadingFrame, TweenInfo.new(0.4), {BackgroundTransparency = 1})
    fadeOut:Play()
    
    for _, child in ipairs(LoadingFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            TweenService:Create(child, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        elseif child:IsA("Frame") then
            TweenService:Create(child, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        end
    end
    
    task.wait(0.4)
    LoadingFrame:Destroy()
    
    -- Появление главного закруглённого окна
    MainFrame.Visible = true
end)
