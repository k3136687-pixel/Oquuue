local function ApplyThemeData(data)
    currentAccent = data.Accent
    for _, obj in ipairs(UI_Registry.MainFrames) do obj.BackgroundColor3 = data.Bg end
    for _, obj in ipairs(UI_Registry.Headers) do obj.BackgroundColor3 = data.Header end
    for _, obj in ipairs(UI_Registry.Strokes) do obj.Color = data.Accent end
    for _, obj in ipairs(UI_Registry.Accents) do obj.TextColor3 = data.Accent end
    for _, obj in ipairs(UI_Registry.Texts) do obj.TextColor3 = data.Text end
    
    for _, obj in ipairs(UI_Registry.Buttons) do 
        obj.BackgroundColor3 = ButtonStyle.Bg 
        obj.TextColor3 = ButtonStyle.Text
    end

    for _, toggle in ipairs(UI_Registry.Toggles) do
        if toggle.Active then
            toggle.StatusBox.BackgroundColor3 = data.Accent
        end
    end
end

local function SetTheme(themeName)
    if themeName == "RGB" then
        isRGBMode = true
    else
        isRGBMode = false
        if Themes[themeName] then
            ApplyThemeData(Themes[themeName])
        end
    end
end

