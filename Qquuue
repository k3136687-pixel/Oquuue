local pages = {}
local tabButtons = {}
local activeTab = nil

local function CreatePage(name)
    local scroller = Instance.new("ScrollingFrame")
    scroller.Size = UDim2.new(1, 0, 1, 0)
    scroller.BackgroundTransparency = 1
    scroller.BorderSizePixel = 0
    scroller.ScrollBarThickness = 4
    scroller.Visible = false
    scroller.Parent = PagesContainer

    local uiList = Instance.new("UIListLayout")
    uiList.Padding = UDim.new(0, 6)
    uiList.SortOrder = Enum.SortOrder.LayoutOrder
    uiList.Parent = scroller

    uiList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroller.CanvasSize = UDim2.new(0, 0, 0, uiList.AbsoluteContentSize.Y + 10)
    end)

    pages[name] = scroller

    -- Кнопка вкладки сверху
    local tBtn = Instance.new("TextButton")
    tBtn.Size = UDim2.new(0, 55, 1, 0)
    tBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
    tBtn.BorderSizePixel = 0
    tBtn.Text = name
    tBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tBtn.TextSize = 11
    tBtn.Font = Enum.Font.SourceSansBold
    tBtn.Parent = TabBar

    tBtn.MouseButton1Click:Connect(function()
        for pName, page in pairs(pages) do
            page.Visible = (pName == name)
        end
        for _, btn in pairs(tabButtons) do
            btn.TextColor3 = Color3.fromRGB(180, 180, 180)
            btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
        end
        tBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        tBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end)

    tabButtons[name] = tBtn
    if not activeTab then
        activeTab = name
        scroller.Visible = true
        tBtn.TextColor3 = Color3.fromRGB(255, 170, 0)
        tBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end

    return scroller
end

